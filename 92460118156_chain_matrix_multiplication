#include <iostream>
#include <vector>
#include <climits>

using namespace std;

int main() {
    int n;

    cout << "Enter number of matrices: ";
    cin >> n;

    // p stores the dimensions of matrices
    // Matrix A1 = p[0] x p[1]
    // Matrix A2 = p[1] x p[2]
    // and so on
    vector<int> p(n + 1);

    cout << "Enter matrix dimensions: ";
    for (int i = 0; i <= n; i++) {
        cin >> p[i];
    }

    // dp[i][j] = minimum number of scalar multiplications
    // needed to multiply matrices from i to j
    vector<vector<int>> dp(n + 1, vector<int>(n + 1, 0));

    // Calculate minimum multiplication cost
    for (int length = 2; length <= n; length++) {

        for (int i = 1; i <= n - length + 1; i++) {

            int j = i + length - 1;

            dp[i][j] = INT_MAX;

            for (int k = i; k < j; k++) {

                int cost = dp[i][k]
                         + dp[k + 1][j]
                         + p[i - 1] * p[k] * p[j];

                dp[i][j] = min(dp[i][j], cost);
            }
        }
    }

    cout << "Minimum number of multiplications: "
         << dp[1][n];

    return 0;
}
