#include <iostream>
#include <climits>
using namespace std;

int main() {
    int n;
    cin >> n;

    int graph[100][100];

    // Input graph
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            cin >> graph[i][j];
        }
    }

    int key[100];
    int parent[100];
    bool mst[100];

    for (int i = 0; i < n; i++) {
        key[i] = INT_MAX;
        mst[i] = false;
    }

    key[0] = 0;
    parent[0] = -1;

    // Prim's Algorithm
    for (int count = 0; count < n - 1; count++) {
        int u = -1;

        // Find minimum key vertex
        for (int v = 0; v < n; v++) {
            if (!mst[v] && (u == -1 || key[v] < key[u])) {
                u = v;
            }
        }

        mst[u] = true;

        // Update adjacent vertices
        for (int v = 0; v < n; v++) {
            if (graph[u][v] != 0 &&
                !mst[v] &&
                graph[u][v] < key[v]) {

                key[v] = graph[u][v];
                parent[v] = u;
            }
        }
    }

    // Print MST
    int totalWeight = 0;

    cout << "Edge\tWeight\n";

    for (int i = 1; i < n; i++) {
        cout << parent[i] << " - " << i
             << "\t" << graph[i][parent[i]] << endl;

        totalWeight += graph[i][parent[i]];
    }

    cout << "Total Weight = " << totalWeight << endl;

    return 0;
}
