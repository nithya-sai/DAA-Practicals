#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;

int main() {
    int capacity, n;

    cout << "Enter knapsack capacity: ";
    cin >> capacity;

    cout << "Enter number of items: ";
    cin >> n;

    vector<int> weights(n);
    vector<int> values(n);

    cout << "Enter weights of items: ";
    for (int i = 0; i < n; i++) {
        cin >> weights[i];
    }

    cout << "Enter values of items: ";
    for (int i = 0; i < n; i++) {
        cin >> values[i];
    }

    // dp[i][w] = maximum value using first i items
    // with knapsack capacity w
    vector<vector<int>> dp(n + 1, vector<int>(capacity + 1, 0));

    // Calculate maximum value for every item and capacity
    for (int i = 1; i <= n; i++) {

        for (int w = 1; w <= capacity; w++) {

            if (weights[i - 1] <= w) {

                // Maximum of including or excluding the item
                dp[i][w] = max(
                    values[i - 1] + dp[i - 1][w - weights[i - 1]],
                    dp[i - 1][w]
                );

            } else {

                // Item cannot fit, so exclude it
                dp[i][w] = dp[i - 1][w];
            }
        }
    }

    cout << "Maximum value: " << dp[n][capacity];

    return 0;
}
